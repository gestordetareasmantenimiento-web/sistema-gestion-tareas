ALTER TABLE proveedores ADD COLUMN centro TEXT;
ALTER TABLE proveedores ADD COLUMN almacen TEXT;

-- 2. Poblar los datos para los proveedores existentes (puedes ajustar los valores)
UPDATE proveedores SET centro = 'RC01', almacen = 'M110' WHERE id = 1; -- Constructora del Norte S.A.
UPDATE proveedores SET centro = 'RC02', almacen = 'M245' WHERE id = 2; -- Servicios Eléctricos Sur S.R.L.
UPDATE proveedores SET centro = 'RC01', almacen = 'M180' WHERE id = 3; -- Ingeniería Civil Oeste S.A.
UPDATE proveedores SET centro = 'RC03', almacen = 'M320' WHERE id = 4; -- Mantenimiento Integral Este S.R.L.</sql><current_tab id="0"/></tab_sql></sqlb_project>
